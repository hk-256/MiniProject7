

<% layout("layouts/BoilerPlate") %>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../utils/index.css">
</head>
<body>

    <h1>
        locations and coordinates
    </h1>

    <form action="/add" method="post" >

        <input type="text" name="location" id="location" placeholder="location">
        <button>submit</button>

    </form>
    <ul>
        <% for(let obj of info){ %>
            <li>
                <b><%= obj.location %> </b> : <%= obj.geometry.coordinates[0] %>, <%= obj.geometry.coordinates[1] %>
            </li>
        <% } %>
    </ul>
    <hr>

    <a href="/download-json" download="data.json">Download JSON</a>
    <hr>

    <h1>Distance Matrix</h1>

    <table border="1">
        <!-- printing locations in first col -->
        <thead>
            <tr>
                <th>
                    /
                </th>
                <%info.forEach(obj=>{%>
                    <th>
                        <%=obj.location%>
                    </th>
                <%})%>
            </tr>
        </thead>
        <% let i = 0 %>
        <% distances.forEach(row=>{ %>
            <tr>
                <!-- printing locations in every row -->
                <td>
                    <b><%= info[i].location  %></b>
                    <% i++ %>
                </td>
                <% row.forEach(cell=>{ %>
                    <td>
                        <%= Math.round(cell/1000) %> km
                    </td>
                <% }) %>
            </tr>
        <% }) %>

    </table>

    <h1>Duration Matrix</h1>
    <table border="1">

        <!-- printing locations in first col -->
        <thead>
            <tr>
                <th>
                    /
                </th>
                <%info.forEach(obj=>{%>
                    <th>
                        <%=obj.location%>
                    </th>
                <%})%>
            </tr>
        </thead>

        <% i = 0 %>


        <% durations.forEach(row=>{ %>
            <tr>
                <!-- printing locations in every row -->
                <td>
                    <b><%= info[i].location %></b>
                    <% i++ %>
                </td>
                <% row.forEach(cell=>{ %>
                    <td>
                        <%= Math.round(cell/60) %> min
                    </td>
                <% }) %>
            </tr>
        <% }) %>

    </table>

</body>
</html>