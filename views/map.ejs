<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mapbox Example</title>
  <script src="https://api.mapbox.com/mapbox-gl-js/v2.17.0/mapbox-gl.js"></script>
  <link href="https://api.mapbox.com/mapbox-gl-js/v2.17.0/mapbox-gl.css" rel="stylesheet" />
  <style>
    #map {
      width: 100%;
      height: 500px;
    }
  </style>
</head>
<body>
    <h1>we are here</h1>
  <div id="map"></div>
  <script>
    // Your JavaScript here
    mapboxgl.accessToken = 'pk.eyJ1IjoidGFuaXNoMTIwNiIsImEiOiJjbTB4dHlqaXIwajQ4MmpzZ2htY2c4azZ1In0.FLpGwafUZ3pb5FI7XhmoQA'; // Replace with your token
    const longitude = -122.4194  , latitude = 37.7749;
    const map = new mapboxgl.Map({
    container: 'map', // ID of the HTML element
    style: 'mapbox://styles/mapbox/streets-v11', // Map style
    center: [longitude, latitude], // Starting position [lng, lat]
    zoom: 12 // Zoom level
    });

    // Add a marker
    const marker = new mapboxgl.Marker()
    .setLngLat([longitude, latitude]) // Marker position [lng, lat]
    .addTo(map);

  </script>
</body>
</html>
