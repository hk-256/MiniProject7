

<% layout("layouts/BoilerPlate") %>


<div class="row">
    <div class="col-6">

        <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <% camp.image.forEach((image,i)=>{%>
                        <div class="carousel-item <%= i===0 ? 'active' : ''  %> ">
                            <img src="<%=image.url%>" class="d-block w-100 rounded-5" alt="" >
                        </div>
                <% }) %>
            </div>
            <% if(camp.image.length > 1){ %>
                <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
                </a>
            <% } %>
        </div>
       
    

          
    </div>
    <div class="col-6">
        <div class="container my-5">
            <div class="row justify-content-center">
              <div class="col-lg-8 text-center">
                <h2 class="fw-bold mb-4"><%=camp.title%></h2>

                <p class="lead text-muted">
                    <%=camp.location%>
                </p>
                <p class="lead text-muted">
                    <%=camp.description%>
                </p>
              </div>
            </div>
          </div>
      
    </div>
    
</div>


<div class="container my-5">
    <h2 class="text-center mb-4">Bookings</h2>
  
    <table class="table table-striped table-hover">
      <thead class="table-primary">
        <tr>
          <th scope="col">Room Number</th>
          <th scope="col">Type</th>
          <th scope="col" class="text-center">Name</th>
          <th scope="col" class="text-center">Number</th>
          <th scope="col" class="text-center">Addhar Number</th>
          <th scope="col" class="text-center">No. Of Days</th>
        </tr>
      </thead>
      <tbody>
        <!-- Room 1 -->
        <% for(let room of rooms){ %>
            <% for(let booking of room.bookings){ %>
                <tr>
                    <td>Room <%= room.roomNumber %></td>
                    <td><%= room.typeOfRoom %></td>
                    <td class="text-center"><%= booking.name %></td>
                    <td class="text-center"><%= booking.phoneNumber %></td>
                    <td class="text-center"><%= booking.addhar %></td>
                    <td class="text-center"><%= booking.dates.length %></td>
                </tr>
            <% } %>
        <% } %>
      </tbody>
    </table>
    
  </div>



<script>
    const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
    const camp = <%-JSON.stringify(camp)%>;
 </script>
<script src="/javascripts/showPageMap.js"></script>



